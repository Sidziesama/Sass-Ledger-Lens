# PRISM public host, verified against https://blockconvey.com/docs
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=

# Copy the address reported by `gide server status`, including /v1.
LEDGER_LENS_LLM_BASE_URL=
LEDGER_LENS_LLM_API_KEY=
LEDGER_LENS_LLM_MODEL=
LEDGER_LENS_LLM_TIMEOUT=120
# Set false only if the selected server does not support response_format.
LEDGER_LENS_LLM_JSON_MODE=true
